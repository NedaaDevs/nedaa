    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد نِداء مدينتك ومواقيت الصلاة فيها من موقعك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nedaa uses your location to find your city and its prayer times."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedaa menggunakan lokasi anda untuk mencari bandar anda dan waktu solatnya."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نِداء آپ کا مقام استعمال کرتا ہے تاکہ آپ کا شہر اور اس کے نماز کے اوقات معلوم کر سکے۔"
          }
        }
      }
    },
