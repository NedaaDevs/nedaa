      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد نِداء مدينتك ومواقيت الصلاة فيها واتجاه القبلة من موقعك أثناء استخدام التطبيق."
