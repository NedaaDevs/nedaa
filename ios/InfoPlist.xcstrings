    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - AlarmKit Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج نِداء إلى إذن المنبّهات ليوقظك لصلاة الفجر وينبّهك لصلاة الجمعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nedaa needs alarm access to wake you for Fajr and Friday prayers."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedaa memerlukan akses penggera untuk membangunkan anda bagi solat Subuh dan solat Jumaat."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نِداء کو الارم کی اجازت چاہیے تاکہ آپ کو فجر اور جمعہ کی نماز کے لیے جگا سکے۔"
          }
        }
      }
    },
