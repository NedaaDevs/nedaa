        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nedaa uses your location while you use the app to find your city, its prayer times and the Qibla direction."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedaa menggunakan lokasi anda semasa anda menggunakan aplikasi untuk mencari bandar anda, waktu solatnya dan arah kiblat."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نِداء ایپ کے استعمال کے دوران آپ کا مقام استعمال کرتا ہے تاکہ آپ کا شہر، اس کے نماز کے اوقات اور قبلہ کی سمت معلوم کر سکے۔"
          }
        }
