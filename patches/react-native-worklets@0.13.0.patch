diff --git a/apple/worklets/apple/AnimationFrameQueue.mm b/apple/worklets/apple/AnimationFrameQueue.mm
index c0640301c9adc6484798267b790a02a5a1a78042..fec835c64ad61f96b4a832b39947b58427a590fc 100644
--- a/apple/worklets/apple/AnimationFrameQueue.mm
+++ b/apple/worklets/apple/AnimationFrameQueue.mm
@@ -87,7 +87,19 @@ typedef void (^AnimationFrameCallback)(WorkletsDisplayLink *displayLink);
 
 - (void)scheduleQueueExecution
 {
-  [displayLink_ setPaused:FALSE];
+  [self setDisplayLinkPaused:FALSE];
+}
+
+// A paused-state write reaches the render server over a blocking round trip, and
+// CoreAnimation defers part of that work when the write comes from inside a
+// display link dispatch. Writing only on a real change keeps the steady state
+// free of those round trips.
+- (void)setDisplayLinkPaused:(BOOL)paused
+{
+  if ([displayLink_ isPaused] == paused) {
+    return;
+  }
+  [displayLink_ setPaused:paused];
 }
 
 - (void)executeQueue:(WorkletsDisplayLink *)displayLink
@@ -95,7 +107,6 @@ typedef void (^AnimationFrameCallback)(WorkletsDisplayLink *displayLink);
   RCTAssertMainQueue();
 
   auto frameCallbacks = [self pullCallbacks];
-  [displayLink_ setPaused:TRUE];
 
 #if TARGET_OS_OSX
   auto targetTimestamp = displayLink.timestamp + displayLink.duration;
@@ -106,6 +117,12 @@ typedef void (^AnimationFrameCallback)(WorkletsDisplayLink *displayLink);
   for (const auto &callback : frameCallbacks) {
     callback(targetTimestamp);
   }
+
+  // The link keeps running until a tick drains the queue. Callbacks re-arm the
+  // queue from inside this dispatch, so a pause taken before them would need an
+  // immediate unpause and re-enter CoreAnimation on every frame.
+  std::lock_guard<std::mutex> lock(callbacksMutex_);
+  [self setDisplayLinkPaused:frameCallbacks_.empty()];
 }
 
 - (void)executeQueueForProMotion:(WorkletsDisplayLink *)displayLink
