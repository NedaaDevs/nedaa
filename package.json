{
  "name": "nedaa",
  "main": "index.js",
  "version": "2.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "BUILD_VARIANT=gms expo run:android",
    "android:gms": "BUILD_VARIANT=gms expo run:android",
    "android:hms": "BUILD_VARIANT=hms expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "format": "prettier --write",
    "verify:android": "bun run verify:android:gms && bun run verify:android:hms",
    "verify:android:gms": "cd android && BUILD_VARIANT=gms ./gradlew :app:assembleDebug --no-daemon --console=plain",
    "verify:android:hms": "bun scripts/verify-hms-build.ts",
    "bu": "bun scripts/install-hms.ts",
    "prepare": "lefthook install",
    "clean:cache": "./scripts/clean-cache.sh",
    "clean:derived": "./scripts/clean-derived.sh",
    "clean:pods": "./scripts/clean-pods.sh",
    "clean:all": "./scripts/clean-all.sh",
    "fix:android:modules": "./scripts/fix-stale-expo-modules.sh",
    "reinstall:ios": "./scripts/reinstall-ios.sh",
    "nuke": "./scripts/nuke.sh",
    "build:android": "bun run build:android:gms",
    "build:android:gms": "bun scripts/build-local.ts android production",
    "build:android:hms": "bun scripts/build-local.ts android production-hms",
    "build:android:hms:apk": "bun scripts/build-local.ts android production-hms-apk",
    "build:ios": "bun scripts/build-local.ts ios production",
    "build:cities": "bun scripts/build-cities-db.ts",
    "submit:android:closed": "eas submit -p android --latest --profile closed-testing",
    "submit:android:internal": "eas submit -p android --latest --profile internal",
    "submit:android:production": "eas submit -p android --latest --profile production",
    "release:android:closed": "bun run build:android && bun run submit:android:closed",
    "release:android:internal": "bun run build:android && bun run submit:android:internal",
    "release:android:production": "bun run build:android && bun run submit:android:production",
    "screenshots:verify": "cd scripts/screenshots && PATH=\"$HOME/.maestro/bin:$PATH\" bun run.ts verify",
    "eas-build-pre-install": "if [ \"$BUILD_VARIANT\" = \"hms\" ]; then : \"${AGCONNECT_SERVICES_JSON:?AGCONNECT_SERVICES_JSON is required for HMS builds}\"; cp \"$AGCONNECT_SERVICES_JSON\" android/app/agconnect-services.json; fi",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p scripts/screenshots/tsconfig.json",
    "format:check": "git ls-files -z '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.md' '*.yml' | xargs -0 prettier --check"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/",
      "/fixtures/"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|standard-navigation|tamagui|@tamagui|react-native-svg|@gorhom|moti|react-native-reanimated|react-native-worklets|yoga-layout))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/app-integrity": "^58.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tamagui/animations-moti": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "@tamagui/native": "^2.7.7",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~58.0.12",
    "expo-alarm": "file:./modules/expo-alarm",
    "expo-application": "~58.1.1",
    "expo-asset": "~58.0.16",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-custom-notification-sound": "file:./modules/expo-custom-notification-sound",
    "expo-dev-menu": "~58.0.11",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.6",
    "expo-hms-compat": "file:./modules/expo-hms-compat",
    "expo-hms-location": "file:./modules/expo-hms-location",
    "expo-hms-notifications": "file:./modules/expo-hms-notifications",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.16",
    "expo-mail-composer": "~58.0.3",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.4",
    "expo-orientation": "file:./modules/expo-orientation",
    "expo-router": "~58.0.21",
    "expo-sharing": "~58.0.18",
    "expo-splash-screen": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-widget": "file:./modules/expo-widget",
    "expo-widgets": "file:./modules/expo-widgets",
    "hijri-native": "0.2.0",
    "i18next": "^26.4.2",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^1.47.0",
    "miftah": "^1.1.5",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.88.0",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-email-link": "^1.16.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-nitro-player": "~1.4.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "react-native-zip-archive": "^9.5.1",
    "tamagui": "^2.7.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@tamagui/babel-plugin": "^2.7.7",
    "@tamagui/cli": "^2.7.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/bun": "^1.4.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "baseline-browser-mapping": "^2.11.19",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-dev-client": "~58.0.13",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "lefthook": "^2.1.17",
    "metro-minify-terser": "^0.83.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "yoga-layout": "^3.2.1"
  },
  "private": true,
  "patchedDependencies": {
    "react-native-worklets@0.13.0": "patches/react-native-worklets@0.13.0.patch"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-worklets"
        ]
      }
    },
    "install": {
      "exclude": [
        "expo-widget",
        "expo-widgets"
      ]
    }
  }
}
